node_modules/
dist/
dist-bundle/
*.tsbuildinfo
.DS_Store
.omo/evidence/
.omo/tmp/
.remotion/
# Generated Remotion Studio workspaces (video studio)
.studio/
*.log
.omo/run-continuation/
coverage/

# Python venv (uv) for the Pillow contact-sheet helper (never tracked)
packages/media-generators/python/.venv/

# Test projects hold generated media (hundreds of MB) — only the
# canonical benchmark fixture is tracked.
projects/*
!projects/benchmark-v01/

# Derived render artifacts — regenerated by the pipeline on every run
# (the §62.4 audit sequence rewrites scenes/, qa/, runs/, checkpoints/,
# and output/ from the tracked fixture sources).
projects/benchmark-v01/scenes/
projects/benchmark-v01/qa/
projects/benchmark-v01/output/

# Local tooling noise + benchmark run outputs (canonical fixture only —
# see the projects/benchmark-v01/ block above).
__pycache__/
projects/benchmark-v01/runs/
projects/benchmark-v01/youtube/
stderr.txt

# Local image-provider A/B evidence (scripts/measure-image-providers.mjs
# regenerates it): the comparison PNGs and the provider backups are
# tens of MB and the numbers live in docs/RELEASES.md.
runs/image-provider-ab/
runs/frames/

# runs/ holds runtime artifacts only — per-call run records, judge caches,
# failed-reply dumps, launchd tick logs, script outputs. Regenerable or
# ephemeral; the durable numbers they carried live in docs/. Everything
# under it stays local (untracked since 2026-11-19).
runs/
