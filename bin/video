#!/usr/bin/env bash
# Maps `video <verb> [args...]` to `node packages/cli/dist/index.js <verb> [args...]`.
# A fresh clone won't have packages/cli/dist/ until you run `pnpm build` —
# fail with the actual fix instead of Node's raw module-not-found stack.

set -euo pipefail

entry="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)/packages/cli/dist/index.js"
if [[ ! -f "$entry" ]]; then
    echo "not built — run: pnpm build" >&2
    exit 1
fi
exec node "$entry" "$@"
