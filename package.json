{
  "name": "video-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Video Factory \u2014 structured-content-to-video production system (v0.1)",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "render:hello": "pnpm --filter @vf/video-renderer run render:hello",
    "publish:packages:dry-run": "pnpm run build && pnpm publish --filter \"./packages/*\" --access public --dry-run",
    "publish:packages": "pnpm run build && pnpm publish --filter \"./packages/*\" --access public",
    "benchmark:verify": "node scripts/benchmark-verify.mjs",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
