{
  "name": "video-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Video Factory \u2014 structured-content-to-video production system (v0.1)",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "render:hello": "pnpm --filter @vf/video-renderer run render:hello",
    "publish:packages:dry-run": "pnpm run build && pnpm publish --filter \"./packages/*\" --access public --dry-run",
    "publish:packages": "pnpm run build && pnpm publish --filter \"./packages/*\" --access public",
    "benchmark:verify": "node scripts/benchmark-verify.mjs",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
