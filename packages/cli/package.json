{
  "name": "@vf/cli",
  "version": "0.1.0",
  "description": "AI Video Factory command-line interface",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "bin": {
    "vf": "dist/index.js"
  },
  "dependencies": {
    "@vf/vdsl": "workspace:*",
    "@vf/video-components": "workspace:*",
    "@vf/media": "workspace:*",
    "commander": "^13.0.0",
    "@vf/workflow": "workspace:*",
    "@vf/video-renderer": "workspace:*",
    "@vf/research": "workspace:*",
    "@vf/script": "workspace:*",
    "@vf/llm": "workspace:*",
    "@vf/tts": "workspace:*",
    "@vf/review": "workspace:*",
    "@vf/youtube": "workspace:*",
    "@vf/media-generators": "workspace:*",
    "@vf/audio-assets": "workspace:*",
    "@vf/audio-mix": "workspace:*",
    "yaml": "^2.7.0"
  }
}
