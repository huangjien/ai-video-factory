{
  "name": "@video/cli",
  "version": "0.1.0",
  "description": "AI Video Factory command-line interface",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "bin": {
    "video": "dist/index.js"
  },
  "dependencies": {
    "@video/agent-storyboard": "workspace:*",
    "@video/audio-assets": "workspace:*",
    "@video/audio-mix": "workspace:*",
    "@video/audio-plan": "workspace:*",
    "@video/draft": "workspace:*",
    "@video/llm": "workspace:*",
    "@video/make": "workspace:*",
    "@video/media": "workspace:*",
    "@video/media-generators": "workspace:*",
    "@video/motion": "workspace:*",
    "@video/qa": "workspace:*",
    "@video/research": "workspace:*",
    "@video/review": "workspace:*",
    "@video/script": "workspace:*",
    "@video/tts": "workspace:*",
    "@video/vdsl": "workspace:*",
    "@video/video-components": "workspace:*",
    "@video/video-renderer": "workspace:*",
    "@video/workflow": "workspace:*",
    "@video/youtube": "workspace:*",
    "commander": "^13.0.0",
    "yaml": "^2.7.0"
  }
}
